 #:set USING_AMD = (MFC_COMPILER == AMD_COMPILER_ID)
 
+! Async clause for the kernels and scalar updates that run every RK stage. NVHPC runs the default async queue on the
+! synchronous stream (s_initialize_mpi_domain), so these stay ordered with all other GPU work and the host only waits
+! where device data leaves OpenACC (MPI with device buffers). Other compilers keep the synchronous behaviour.
+#:set GPU_ASYNC = 'async' if USING_NVHPC else None
+
 #:def ASSERT_LIST(data, datatype)
     #:assert data is not None
     #:assert isinstance(data, list)
