             end do
 
             do j = eqn_idx%adv%beg, eqn_idx%adv%end
                 nullify (q_prim_qp%vf(j)%sf)
             end do
 
-            do j = eqn_idx%mom%beg, eqn_idx%E
-                @:DEALLOCATE(q_cons_qp%vf(j)%sf)
-                @:DEALLOCATE(q_prim_qp%vf(j)%sf)
