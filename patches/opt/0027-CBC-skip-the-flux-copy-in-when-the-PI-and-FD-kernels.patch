From 39c96b3300de7b2df59f953e09e2a2c8b72fe00f Mon Sep 17 00:00:00 2001
From: xs1128 <ooixinsheng@gmail.com>
Date: Tue, 3 Nov 2026 01:12:11 +0800
Subject: [PATCH] CBC: skip the flux copy-in when the PI and FD kernels
 overwrite every copied-back value, and copy back only the changed layers

With WENO3/5, PI2/PI4 write flux layers 0(..1) of every CBC flux and advection source and the FD kernel writes layer -1
of every continuity, momentum, energy, advection and species flux before anything reads them, so copying all
-1..buff_size layers in was dead work. s_finalize_cbc now copies back only layers -1..(weno_order-3)/2; the others were
returned unchanged (x*s*s with s = +-1 is exact). Any other configuration keeps the full copies.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/simulation/m_cbc.fpp | 224 ++++++++++++++++++++++-----------------
 1 file changed, 128 insertions(+), 96 deletions(-)

diff --git a/src/simulation/m_cbc.fpp b/src/simulation/m_cbc.fpp
index 23c16f3..228f8ad 100644
--- a/src/simulation/m_cbc.fpp
+++ b/src/simulation/m_cbc.fpp
@@ -71,6 +71,11 @@ module m_cbc
     $:GPU_DECLARE(create='[dj]')
     $:GPU_DECLARE(create='[cbc_dir, cbc_loc, flux_cbc_index]')
 
+    !> True when the PI and FD kernels in s_cbc write every flux value that s_finalize_cbc copies back, so s_initialize_cbc need not
+    !! copy the fluxes in. s_cbc only changes flux layers -1..cbc_flux_jend; the rest are copied back unchanged.
+    logical :: cbc_flux_overwritten
+    integer :: cbc_flux_jend
+
     ! GRCBC inputs for subsonic inflow and outflow conditions consisting of inflow velocities, pressure, density and void fraction
     ! as well as outflow velocities and pressure
 
@@ -97,6 +102,20 @@ contains
         end if
         $:GPU_UPDATE(device='[flux_cbc_index]')
 
+        ! WENO3 (PI2) writes flux layer 0 and WENO5 (PI4) layers 0..1 of every flux and advection source; the FD kernel then
+        ! writes layer -1 of the continuity, momentum, energy, advection and (with chemistry) species fluxes.
+        cbc_flux_overwritten = recon_type == recon_type_weno .and. (weno_order == 3 .or. weno_order == 5)
+        do i = 1, flux_cbc_index
+            if (.not. (i <= eqn_idx%cont%end .or. (i >= eqn_idx%mom%beg .and. i <= eqn_idx%mom%end) .or. i == eqn_idx%E &
+                & .or. (i >= eqn_idx%adv%beg .and. i <= eqn_idx%adv%end) .or. (chemistry .and. i >= eqn_idx%species%beg &
+                & .and. i <= eqn_idx%species%end))) cbc_flux_overwritten = .false.
+        end do
+        if (cbc_flux_overwritten) then
+            cbc_flux_jend = (weno_order - 3)/2
+        else
+            cbc_flux_jend = buff_size
+        end if
+
         call s_any_cbc_boundaries(is_cbc)
 
         if (is_cbc .eqv. .false.) return
