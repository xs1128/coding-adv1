index 0000000..701f7cd
--- /dev/null
+++ b/src/simulation/include/weno5_macros.fpp
@@ -0,0 +1,94 @@
+!>
+!! @file
+!! @brief WENO5 point reconstruction, shared by s_weno (m_weno) and the HLLC solver that reconstructs in-kernel
+!! (m_riemann_solver_hllc, recon_riemann_fused). One definition keeps the two bitwise identical.
+!!
+!! Names are passed in so each caller keeps its own private variables. XYZ is the sweep suffix (x/y/z) of the coefficient
+!! tables, CELL the cell index along the sweep, DIR the sweep direction, DVD(-2:1) the undivided differences of the cell's
+!! stencil, V0 its cell value. Needs m_weno's tables and uniform_grid in scope.
+
+!> Smoothness indicators BETA(0:2) of cell CELL
+#:def WENO5_BETA(XYZ, CELL, DIR, DVD, BETA)
+    if (uniform_grid(${DIR}$)) then
+        ${BETA}$ (0) = 13._wp/12._wp*(${DVD}$ (1) - ${DVD}$ (0))**2 + 0.25_wp*(${DVD}$ (1) - 3._wp*${DVD}$ (0))**2 + weno_eps
+        ${BETA}$ (1) = 13._wp/12._wp*(${DVD}$ (0) - ${DVD}$ (-1))**2 + 0.25_wp*(${DVD}$ (0) + ${DVD}$ (-1))**2 + weno_eps
+        ${BETA}$ (2) = 13._wp/12._wp*(${DVD}$ (-1) - ${DVD}$ (-2))**2 + 0.25_wp*(3._wp*${DVD}$ (-1) - ${DVD}$ (-2))**2 + weno_eps
+    else
+        ${BETA}$ (0) = beta_coef_${XYZ}$ (${CELL}$, 0, 0)*${DVD}$ (1)*${DVD}$ (1) + beta_coef_${XYZ}$ (${CELL}$, 0, &
+                  & 1)*${DVD}$ (1)*${DVD}$ (0) + beta_coef_${XYZ}$ (${CELL}$, 0, 2)*${DVD}$ (0)*${DVD}$ (0) + weno_eps
+        ${BETA}$ (1) = beta_coef_${XYZ}$ (${CELL}$, 1, 0)*${DVD}$ (0)*${DVD}$ (0) + beta_coef_${XYZ}$ (${CELL}$, 1, &
+                  & 1)*${DVD}$ (0)*${DVD}$ (-1) + beta_coef_${XYZ}$ (${CELL}$, 1, 2)*${DVD}$ (-1)*${DVD}$ (-1) + weno_eps
+        ${BETA}$ (2) = beta_coef_${XYZ}$ (${CELL}$, 2, 0)*${DVD}$ (-1)*${DVD}$ (-1) + beta_coef_${XYZ}$ (${CELL}$, 2, &
+                  & 1)*${DVD}$ (-1)*${DVD}$ (-2) + beta_coef_${XYZ}$ (${CELL}$, 2, 2)*${DVD}$ (-2)*${DVD}$ (-2) + weno_eps
+    end if
+#:enddef
+
+!> OUT = the WENO5 value of cell CELL at its boundary CB ('cbL' or 'cbR'), from DVD, V0 and BETA. FIRST=False is the cell's second
+!! boundary: WENO-Z's tau and TENO's cut-off delta depend on BETA only, so they are reused from the first.
+#:def WENO5_SIDE(CB, XYZ, CELL, V0, DVD, BETA, POLY, ALPHA, OMEGA, TAU, DELTA, OUT, FIRST=True)
+    ${POLY}$ (0) = ${V0}$ + poly_coef_${CB}$_${XYZ}$ (${CELL}$, 0, 0)*${DVD}$ (1) + poly_coef_${CB}$_${XYZ}$ (${CELL}$, 0, &
+              & 1)*${DVD}$ (0)
+    ${POLY}$ (1) = ${V0}$ + poly_coef_${CB}$_${XYZ}$ (${CELL}$, 1, 0)*${DVD}$ (0) + poly_coef_${CB}$_${XYZ}$ (${CELL}$, 1, &
+              & 1)*${DVD}$ (-1)
+    ${POLY}$ (2) = ${V0}$ + poly_coef_${CB}$_${XYZ}$ (${CELL}$, 2, 0)*${DVD}$ (-1) + poly_coef_${CB}$_${XYZ}$ (${CELL}$, 2, &
+              & 1)*${DVD}$ (-2)
+
+    if (wenojs) then
+        $:GPU_LOOP(parallelism='[seq]')
+        do q = 0, weno_num_stencils
+            ${ALPHA}$ (q) = d_${CB}$_${XYZ}$ (q, ${CELL}$)/(${BETA}$ (q)**2._wp)
+        end do
+    else if (mapped_weno) then
+        $:GPU_LOOP(parallelism='[seq]')
+        do q = 0, weno_num_stencils
+            ${ALPHA}$ (q) = d_${CB}$_${XYZ}$ (q, ${CELL}$)/(${BETA}$ (q)**2._wp)
+        end do
+        ${OMEGA}$ = ${ALPHA}$/sum(${ALPHA}$)
+        $:GPU_LOOP(parallelism='[seq]')
+        do q = 0, weno_num_stencils
+            ${ALPHA}$ (q) = (d_${CB}$_${XYZ}$ (q, ${CELL}$)*(1._wp + d_${CB}$_${XYZ}$ (q, &
+                       & ${CELL}$) - 3._wp*${OMEGA}$ (q)) + ${OMEGA}$ (q)**2._wp)*(${OMEGA}$ (q)/(d_${CB}$_${XYZ}$ (q, &
+                       & ${CELL}$)**2._wp + ${OMEGA}$ (q)*(1._wp - 2._wp*d_${CB}$_${XYZ}$ (q, ${CELL}$))))
+        end do
+    else if (wenoz) then
+        ! Borges, et al. (2008)
+        #:if FIRST
+            ${TAU}$ = abs(${BETA}$ (2) - ${BETA}$ (0))  ! Equation 25
+        #:endif
+        $:GPU_LOOP(parallelism='[seq]')
+        do q = 0, weno_num_stencils
+            ! Equation 28 (note: weno_eps was already added to beta)
+            ${ALPHA}$ (q) = d_${CB}$_${XYZ}$ (q, ${CELL}$)*(1._wp + (${TAU}$/${BETA}$ (q)))
+        end do
+    else if (teno) then
+        #:if FIRST
+            ! Fu, et al. (2016) Fu''s code: https://dx.doi.org/10.13140/RG.2.2.36250.34247
+            ${TAU}$ = abs(${BETA}$ (2) - ${BETA}$ (0))
+            $:GPU_LOOP(parallelism='[seq]')
+            do q = 0, weno_num_stencils
+                ${ALPHA}$ (q) = 1._wp + ${TAU}$/${BETA}$ (q)  ! Equation 22 (reuse alpha as gamma; pick C=1 & q=6)
+                ! Equation 22 cont. (some CPU compilers cannot optimize x**6.0)
+                ${ALPHA}$ (q) = (${ALPHA}$ (q)**3._wp)**2._wp
+            end do
+            ${OMEGA}$ = ${ALPHA}$/sum(${ALPHA}$)  ! Equation 25 (reuse omega as xi)
+            $:GPU_LOOP(parallelism='[seq]')
+            do q = 0, weno_num_stencils
+                if (${OMEGA}$ (q) < teno_CT) then  ! Equation 26
+                    ${DELTA}$ (q) = 0._wp
+                else
+                    ${DELTA}$ (q) = 1._wp
+                end if
+            end do
+        #:endif
+        $:GPU_LOOP(parallelism='[seq]')
+        do q = 0, weno_num_stencils
+            ${ALPHA}$ (q) = ${DELTA}$ (q)*d_${CB}$_${XYZ}$ (q, ${CELL}$)  ! Equation 27
+        end do
+    end if
+
+    ${OMEGA}$ (0) = ${ALPHA}$ (0)/(${ALPHA}$ (0) + ${ALPHA}$ (1) + ${ALPHA}$ (2))
+    ${OMEGA}$ (1) = ${ALPHA}$ (1)/(${ALPHA}$ (0) + ${ALPHA}$ (1) + ${ALPHA}$ (2))
+    ${OMEGA}$ (2) = ${ALPHA}$ (2)/(${ALPHA}$ (0) + ${ALPHA}$ (1) + ${ALPHA}$ (2))
+
+    ${OUT}$ = ${OMEGA}$ (0)*${POLY}$ (0) + ${OMEGA}$ (1)*${POLY}$ (1) + ${OMEGA}$ (2)*${POLY}$ (2)
+#:enddef
