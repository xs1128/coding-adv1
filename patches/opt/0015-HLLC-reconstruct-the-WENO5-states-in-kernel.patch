+            recon_riemann_fused = flux_aliased .and. riemann_solver == riemann_solver_hllc .and. model_eqns == model_eqns_5eq &
+                & .and. recon_type == recon_type_weno .and. weno_order == 5 .and. .not. (mp_weno .or. weno_Re_flux &
+                & .or. cont_damage .or. mhd .or. igr) .and. int_comp == 0 .and. sys_size <= recon_riemann_fused_nmax &
+                & .and. all([bc_x%beg, bc_x%end, bc_y%beg, bc_y%end, bc_z%beg, bc_z%end] /= BC_RIEMANN_EXTRAP)
             adv_src_fused = adv_src_mode == adv_src_mode_vel_iface .and. .not. (alt_soundspeed .or. cyl_coord) &
                 & .and. model_eqns /= model_eqns_6eq .and. hypo_nc_mode /= hypo_nc_mode_dual_pass
             if (flux_aliased) then
@@ -948,7 +955,9 @@ contains
 
         call nvtxStartRange("RHS-RECONSTRUCTION")
 
-        if (.not. surface_tension) then
+        if (recon_riemann_fused) then
+            ! The Riemann solver reconstructs these states itself
