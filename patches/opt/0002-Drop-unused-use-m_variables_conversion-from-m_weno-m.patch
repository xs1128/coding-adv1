From e6a3a813b6e51ef8427a7c2111d9cb82e28ec968 Mon Sep 17 00:00:00 2001
From: hipac1 <hipac1@lsalab.cs.nthu.edu.tw>
Date: Fri, 23 Oct 2026 10:43:38 +0800
Subject: [PATCH 2/4] Drop unused 'use m_variables_conversion' from m_weno,
 m_muscl, m_surface_tension

None of the three references anything from the module. Removing the edges keeps them out of the
m_variables_conversion..m_riemann_solvers dependency slice compiled as one unit in the next commit.
---
 src/simulation/m_muscl.fpp           | 1 -
 src/simulation/m_surface_tension.fpp | 1 -
 src/simulation/m_weno.fpp            | 1 -
 3 files changed, 3 deletions(-)

diff --git a/src/simulation/m_muscl.fpp b/src/simulation/m_muscl.fpp
index 23fa67c..8c30389 100644
--- a/src/simulation/m_muscl.fpp
+++ b/src/simulation/m_muscl.fpp
@@ -9,7 +9,6 @@ module m_muscl
 
     use m_derived_types
     use m_global_parameters
-    use m_variables_conversion
     use m_constants, only: muscl_order_first_order, muscl_order_second_order, muscl_lim_unlimited, muscl_lim_minmod, &
         & muscl_lim_mc, muscl_lim_van_albada, muscl_lim_van_leer, muscl_lim_superbee
 #ifdef MFC_OpenACC
diff --git a/src/simulation/m_surface_tension.fpp b/src/simulation/m_surface_tension.fpp
index 2fbe622..cfd95ac 100644
--- a/src/simulation/m_surface_tension.fpp
+++ b/src/simulation/m_surface_tension.fpp
@@ -11,7 +11,6 @@ module m_surface_tension
     use m_derived_types
     use m_global_parameters
     use m_mpi_proxy
-    use m_variables_conversion
     use m_weno
     use m_muscl
     use m_helper
diff --git a/src/simulation/m_weno.fpp b/src/simulation/m_weno.fpp
index ef18917..65c7368 100644
--- a/src/simulation/m_weno.fpp
+++ b/src/simulation/m_weno.fpp
@@ -9,7 +9,6 @@ module m_weno
 
     use m_derived_types
     use m_global_parameters
-    use m_variables_conversion
     use m_mpi_proxy
     use m_thinc, only: s_thinc_compression
     use m_nvtx
