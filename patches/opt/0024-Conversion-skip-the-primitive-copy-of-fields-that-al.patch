From 6611288f039a876cde9228222993f2d6b3019038 Mon Sep 17 00:00:00 2001
From: xs1128 <ooixinsheng@gmail.com>
Date: Mon, 2 Nov 2026 10:33:43 +0800
Subject: [PATCH 24/24] Conversion: skip the primitive copy of fields that
 alias the conservative ones

In the simulation the primitive partial densities and volume fractions are
the same arrays as their conservative fields, so cons -> prim stored each
of those values onto itself: 8 fields written per cell where 4 are needed
(5-equation model), and every store made the kernel reload descriptors.
The copy is now skipped when associated(q_prim(i)%sf, q_cons(i)%sf),
checked once on the host. Pre- and post-process pass separate arrays and
are unchanged.

Storing a value onto itself is a no-op: results are bitwise identical.
perf3d, 1 GPU (H200), with the previous commit: 33.09 -> 29.63 ms per step.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common/m_variables_conversion.fpp | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/src/common/m_variables_conversion.fpp b/src/common/m_variables_conversion.fpp
index 78a1945..73c8abd 100644
--- a/src/common/m_variables_conversion.fpp
+++ b/src/common/m_variables_conversion.fpp
@@ -492,10 +492,22 @@ contains
         real(wp)               :: E, D                     !< Prim/Cons variables within Newton-Raphson iteration
         real(wp)               :: f, dGa_dW, dp_dW, df_dW  !< Functions within Newton-Raphson iteration
         integer                :: iter                     !< Newton-Raphson iteration counter
+        !> The primitive and conservative partial densities (volume fractions) are the same array, as in m_rhs: their copy below
+        !! would store each value onto itself, so it is skipped (and the kernel stores 4 fields instead of 8 for 5-eq)
+        logical :: skip_cont, skip_adv
+
+        skip_cont = associated(qK_prim_vf(1)%sf, qK_cons_vf(1)%sf) .and. associated(qK_prim_vf(eqn_idx%cont%end)%sf, &
+                               & qK_cons_vf(eqn_idx%cont%end)%sf)
+        skip_adv = .false.
+        if (eqn_idx%adv%beg >= 1 .and. eqn_idx%adv%end >= eqn_idx%adv%beg) then
+            skip_adv = associated(qK_prim_vf(eqn_idx%adv%beg)%sf, &
+                                  & qK_cons_vf(eqn_idx%adv%beg)%sf) .and. associated(qK_prim_vf(eqn_idx%adv%end)%sf, &
+                                  & qK_cons_vf(eqn_idx%adv%end)%sf)
+        end if
 
         $:GPU_PARALLEL_LOOP(extraAccArgs=GPU_ASYNC, collapse=3, private='[alpha_K, alpha_rho_K, Re_K, nRtmp, rho_K, gamma_K, &
                             & pi_inf_K, qv_K, dyn_pres_K, rhoYks, B, pres, vftmp, nbub_sc, G_K, solid_partial_density, T, &
-                            & pres_mag, Ga, B2, m2, S, W, dW, E, D, f, dGa_dW, dp_dW, df_dW, iter]')
+                            & pres_mag, Ga, B2, m2, S, W, dW, E, D, f, dGa_dW, dp_dW, df_dW, iter]', firstprivate='[skip_cont, skip_adv]')
         do l = ibounds(3)%beg, ibounds(3)%end
             do k = ibounds(2)%beg, ibounds(2)%end
                 do j = ibounds(1)%beg, ibounds(1)%end
@@ -616,7 +628,7 @@ contains
                         do i = eqn_idx%species%beg, eqn_idx%species%end
                             qK_prim_vf(i)%sf(j, k, l) = max(0._wp, qK_cons_vf(i)%sf(j, k, l)/rho_K)
                         end do
-                    else
+                    else if (.not. skip_cont) then
                         ! Non-reacting: partial densities are directly primitive (alpha_i * rho_i)
                         $:GPU_LOOP(parallelism='[seq]')
                         do i = 1, eqn_idx%cont%end
@@ -737,7 +749,7 @@ contains
                         end do
                     end if
 
-                    if (.not. igr .or. num_fluids > 1) then
+                    if ((.not. igr .or. num_fluids > 1) .and. .not. skip_adv) then
                         $:GPU_LOOP(parallelism='[seq]')
                         do i = eqn_idx%adv%beg, eqn_idx%adv%end
                             qK_prim_vf(i)%sf(j, k, l) = qK_cons_vf(i)%sf(j, k, l)
