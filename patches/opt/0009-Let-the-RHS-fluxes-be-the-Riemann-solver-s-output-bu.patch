                     end do
 
@@ -2259,7 +2286,11 @@ contains
                         end do
                     end if
 
-                    @:DEALLOCATE(flux_src_n(i)%vf(eqn_idx%adv%beg)%sf)
+                    if (flux_aliased) then
+                        nullify (flux_src_n(i)%vf(eqn_idx%adv%beg)%sf)
+                    else
