     contains
 
         !> Add the advection source flux-difference terms for a single coordinate direction to the RHS
@@ -1846,6 +1876,53 @@ contains
 
     end subroutine s_compute_advection_source_term
 
+    !> All directions' flux differences, plus the u-interface alpha*div(u) term, into rhs in one pass (flux_per_dir). Per cell and
+    !! equation: the same operations in the same order as the x, y, z flux-difference kernels it replaces.
+    subroutine s_add_flux_differences(rhs_vf, q_cons_vf)
+
+        type(scalar_field), dimension(sys_size), intent(inout) :: rhs_vf
+        type(vector_field), intent(in)                         :: q_cons_vf
+        integer                                                :: j, k, l, q
+        real(wp)                                               :: inv_dx, inv_dy, inv_dz, r
+
+        $:GPU_PARALLEL_LOOP(extraAccArgs=GPU_ASYNC, collapse=3, private='[j, k, l, q, inv_dx, inv_dy, inv_dz, r]')
+        do l = 0, p
+            do k = 0, n
+                do q = 0, m
+                    inv_dx = 1._wp/dx(q)
+                    inv_dy = 0._wp; inv_dz = 0._wp
+                    if (n > 0) inv_dy = 1._wp/dy(k)
+                    if (p > 0) inv_dz = 1._wp/dz(l)
+                    $:GPU_LOOP(parallelism='[seq]')
+                    do j = 1, sys_size
+                        r = inv_dx*(flux_n(1)%vf(j)%sf(q - 1, k, l) - flux_n(1)%vf(j)%sf(q, k, l))
+                        if (j >= eqn_idx%adv%beg .and. j <= eqn_idx%adv%end) then
+                            r = r + inv_dx*q_cons_vf%vf(j)%sf(q, k, l)*(flux_src_n(1)%vf(j)%sf(q, k, &
+                                                        & l) - flux_src_n(1)%vf(j)%sf(q - 1, k, l))
+                        end if
+                        if (n > 0) then
+                            r = r + inv_dy*(flux_n(2)%vf(j)%sf(q, k - 1, l) - flux_n(2)%vf(j)%sf(q, k, l))
+                            if (j >= eqn_idx%adv%beg .and. j <= eqn_idx%adv%end) then
+                                r = r + inv_dy*q_cons_vf%vf(j)%sf(q, k, l)*(flux_src_n(2)%vf(j)%sf(q, k, &
+                                                            & l) - flux_src_n(2)%vf(j)%sf(q, k - 1, l))
+                            end if
+                        end if
+                        if (p > 0) then
+                            r = r + inv_dz*(flux_n(3)%vf(j)%sf(q, k, l - 1) - flux_n(3)%vf(j)%sf(q, k, l))
+                            if (j >= eqn_idx%adv%beg .and. j <= eqn_idx%adv%end) then
+                                r = r + inv_dz*q_cons_vf%vf(j)%sf(q, k, l)*(flux_src_n(3)%vf(j)%sf(q, k, &
+                                                            & l) - flux_src_n(3)%vf(j)%sf(q, k, l - 1))
+                            end if
+                        end if
+                        rhs_vf(j)%sf(q, k, l) = r
+                    end do
+                end do
+            end do
+        end do
+        $:END_GPU_PARALLEL_LOOP()
+
+    end subroutine s_add_flux_differences
+
     !> Add viscous, surface-tension, and species-diffusion source flux contributions to the RHS for a given direction
