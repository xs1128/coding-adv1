+#ifdef MFC_SIMULATION
+    impure subroutine s_override_proc_topology()
+
+        integer, dimension(3) :: topo
+        integer               :: stat, ios
+        character(len=64)     :: env
+
+        call get_environment_variable('MFC_PROC_TOPO', env, status=stat)
+        if (stat /= 0) return
+        topo = 0
+        read (env, *, iostat=ios) topo
+        if (ios /= 0 .or. any(topo < 1) .or. product(topo) /= num_procs) return
+        num_procs_x = topo(1)
+        num_procs_y = topo(2)
+        num_procs_z = topo(3)
+
+    end subroutine s_override_proc_topology
+#endif
