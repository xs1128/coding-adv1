     end subroutine s_apply_decomposition_policies
 
+#ifdef MFC_SIMULATION
+    !> Experimental (exp-cbclb): move cells from the last rank along an axis whose high end is a characteristic boundary
+    !! (CBC) to the other ranks on that axis. The CBC ranks do extra boundary work in every stage and the others wait for
+    !! them in the halo exchange. MFC_CBC_SHIFT='sx sy sz' in the environment sets how many cells move along x, y, z
+    !! (default 0: unchanged). The grid and the restart data come from the global files at start_idx, so the values
+    !! computed do not change. cells_bounds is updated afterwards: the halo buffers are sized from it (698176 crashed
+    !! with a stale one).
+    impure subroutine s_shift_cells_off_cbc_ends(glb_cells, bc_end, nprocs)
+
+        integer, dimension(3), intent(in) :: glb_cells, bc_end, nprocs
+        integer                           :: shift, d, i, np, cnt, st, stat, ios
+        integer, dimension(3)             :: shifts
+        character(len=64)                 :: env
+
+        call get_environment_variable('MFC_CBC_SHIFT', env, status=stat)
+        shifts = 0
+        if (stat == 0) read (env, *, iostat=ios) shifts
+        if (all(shifts <= 0)) return
+
+        do d = 1, num_dims
+            shift = shifts(d)
+            np = nprocs(d)
+            if (shift <= 0) cycle
+            if (np < 2 .or. bc_end(d) > BC_CHAR_SLIP_WALL .or. bc_end(d) < BC_CHAR_SUP_OUTFLOW) cycle
+            st = 0
+            cnt = 0
+            do i = 0, proc_coords(d)
+                if (i > 0) st = st + cnt
+                cnt = glb_cells(d)/np
+                if (i < mod(glb_cells(d), np)) cnt = cnt + 1
+                if (i == np - 1) then
+                    cnt = cnt - shift
+                else
+                    cnt = cnt + shift/(np - 1)
+                    if (i < mod(shift, np - 1)) cnt = cnt + 1
+                end if
+            end do
+            if (cnt < 1) call s_mpi_abort('MFC_CBC_SHIFT leaves a rank without cells.')
+            select case (d)
+            case (1)
+                m = cnt - 1
+            case (2)
+                n = cnt - 1
+            case (3)
+                p = cnt - 1
+            end select
+            start_idx(d) = st
+        end do
+        call s_update_cell_bounds(cells_bounds, m, n, p)
+
+    end subroutine s_shift_cells_off_cbc_ends
+#endif
+
     !> The goal of this procedure is to populate the buffers of the grid variables by communicating with the neighboring processors.
     !! Note that only the buffers of the cell-width distributions are handled in such a way. This is because the buffers of
     !! cell-boundary locations may be calculated directly from those of the cell-width distributions.
