+
+    !> Make the default queue wait for everything queued so far on cbc_queue, on the GPU only (see cbc_evt).
+    impure subroutine s_cbc_gpu_wait()
+
+        type(c_ptr)    :: h
+        type(c_funptr) :: f_create, f_record, f_wait
+        procedure(cbc_cu_event_create), pointer :: create
+        integer(c_int) :: ierr
+
+        if (.not. cbc_evt_tried) then
+            cbc_evt_tried = .true.
+            h = cbc_dlopen('libcuda.so.1' // c_null_char, 2_c_int)  ! RTLD_NOW
+            if (c_associated(h)) then
+                f_create = cbc_dlsym(h, 'cuEventCreate' // c_null_char)
+                f_record = cbc_dlsym(h, 'cuEventRecord' // c_null_char)
+                f_wait = cbc_dlsym(h, 'cuStreamWaitEvent' // c_null_char)
+                if (c_associated(f_create) .and. c_associated(f_record) .and. c_associated(f_wait)) then
+                    call c_f_procpointer(f_create, create)
+                    call c_f_procpointer(f_record, cbc_evt_record)
+                    call c_f_procpointer(f_wait, cbc_evt_wait)
+                    cbc_evt_ok = create(cbc_evt, 2_c_int) == 0  ! CU_EVENT_DISABLE_TIMING
+                end if
+            end if
+        end if
+        if (cbc_evt_ok) then
+            ierr = cbc_evt_record(cbc_evt, cbc_acc_get_cuda_stream(int(cbc_queue, c_long)))
+            if (ierr == 0) ierr = cbc_evt_wait(cbc_acc_get_cuda_stream(int(acc_get_default_async(), c_long)), cbc_evt, 0_c_int)
+            if (ierr == 0) return
+        end if
+        $:GPU_WAIT(extraAccArgs='(cbc_queue) async')
+
+    end subroutine s_cbc_gpu_wait
 #endif
 
