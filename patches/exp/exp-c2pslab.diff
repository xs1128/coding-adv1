     end subroutine s_convert_conservative_to_primitive_variables
 
+    !> s_convert_conservative_to_primitive_variables on the plain five-equation path, when the fields are the layers of one slab
+    !! (m_rhs q_slab: conservative field i in layer i, primitive velocities and pressure in layers sys_size + i, partial densities
+    !! and volume fractions shared). As an explicit-shape array the slab has one address and fixed strides, so no load walks a field
+    !! descriptor. Same operations in the same order as the general routine (with s_compute_species_fraction inlined), so results
+    !! are bitwise identical. m_rhs calls it only for model_eqns == 2 GPU builds without the extra physics below.
+    subroutine s_convert_conservative_to_primitive_slab(q, lb1, ub1, lb2, ub2, lb3, ub3, ibounds)
+
+        integer, intent(in)                                                      :: lb1, ub1, lb2, ub2, lb3, ub3
+        real(wp), dimension(lb1:ub1,lb2:ub2,lb3:ub3,1:2*sys_size), intent(inout) :: q
+        type(int_bounds_info), dimension(1:3), intent(in)                        :: ibounds
+
+        #:if USING_AMD and not MFC_CASE_OPTIMIZATION
+            real(wp), dimension(3) :: alpha_K, alpha_rho_K
+            real(wp)               :: rhoYks(1:10)
+        #:else
+            real(wp), dimension(num_fluids) :: alpha_K, alpha_rho_K
+            real(wp)                        :: rhoYks(1:num_species)
+        #:endif
+        real(wp), dimension(2) :: Re_K
+        real(wp)               :: rho_K, gamma_K, pi_inf_K, qv_K, dyn_pres_K, alpha_K_sum
+        real(wp)               :: pres, T, pres_mag
+        integer                :: i, j, k, l
+
+        $:GPU_PARALLEL_LOOP(extraAccArgs=GPU_ASYNC, collapse=3, private='[alpha_K, alpha_rho_K, Re_K, rho_K, gamma_K, pi_inf_K, &
+                            & qv_K, dyn_pres_K, alpha_K_sum, rhoYks, pres, T, pres_mag, i]')
+        do l = ibounds(3)%beg, ibounds(3)%end
+            do k = ibounds(2)%beg, ibounds(2)%end
+                do j = ibounds(1)%beg, ibounds(1)%end
+                    dyn_pres_K = 0._wp
+
+                    ! s_compute_species_fraction
+                    if (num_fluids == 1) then
+                        alpha_rho_K(1) = q(j, k, l, eqn_idx%cont%beg)
+                        alpha_K(1) = q(j, k, l, eqn_idx%adv%beg)
+                    else
+                        $:GPU_LOOP(parallelism='[seq]')
+                        do i = 1, num_fluids
+                            alpha_rho_K(i) = q(j, k, l, i)
+                            alpha_K(i) = q(j, k, l, eqn_idx%adv%beg + i - 1)
+                        end do
+                    end if
+
+                    if (mpp_lim) then
+                        alpha_K_sum = 0._wp
+                        $:GPU_LOOP(parallelism='[seq]')
+                        do i = 1, num_fluids
+                            alpha_rho_K(i) = max(0._wp, alpha_rho_K(i))
+                            alpha_K(i) = min(max(0._wp, alpha_K(i)), 1._wp)
+                            alpha_K_sum = alpha_K_sum + alpha_K(i)
+                        end do
+                        alpha_K = alpha_K/max(alpha_K_sum, 1.e-16_wp)
+                    end if
+
+                    call s_convert_species_to_mixture_variables_kernel(rho_K, gamma_K, pi_inf_K, qv_K, alpha_K, alpha_rho_K, Re_K)
+
+                    if (enforce_density_floor_vc) rho_K = max(rho_K, sgm_eps)
+
+                    ! Recover velocity from momentum: u = rho*u / rho, and accumulate dynamic pressure 0.5*rho*|u|^2
+                    $:GPU_LOOP(parallelism='[seq]')
+                    do i = eqn_idx%mom%beg, eqn_idx%mom%end
+                        q(j, k, l, sys_size + i) = q(j, k, l, i)/rho_K
+                        dyn_pres_K = dyn_pres_K + 5.e-1_wp*q(j, k, l, i)*q(j, k, l, sys_size + i)
+                    end do
+
+                    pres_mag = 0._wp
+
+                    call s_compute_pressure(q(j, k, l, eqn_idx%E), q(j, k, l, eqn_idx%alf), dyn_pres_K, pi_inf_K, gamma_K, rho_K, &
+                                            & qv_K, rhoYks, pres, T, pres_mag=pres_mag)
+
+                    q(j, k, l, sys_size + eqn_idx%E) = pres
+                end do
+            end do
+        end do
+        $:END_GPU_PARALLEL_LOOP()
+
+    end subroutine s_convert_conservative_to_primitive_slab
+
